{
    email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
    # TLS_MODE=acme (default: certificati pubblici automatici) oppure internal (CA interna di Caddy, rete locale / IP)
    import /etc/caddy/tls/{$TLS_MODE:acme}.caddy

    # Header di sicurezza
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self)"
        -Server
    }

    # API e streaming SSE verso il backend
    # Niente compressione su /api: con lo streaming SSE la compressione fa arrivare la risposta a blocchi.
    handle /api/* {
        reverse_proxy backend:8000 {
            flush_interval -1
            header_up X-Real-IP {remote_host}
        }
    }

    # File caricati / generati (serviti dal backend con controllo permessi)
    handle /files/* {
        encode zstd gzip
        reverse_proxy backend:8000
    }

    # Editor nel browser (se i profili wordcraft / gridcraft sono attivi)
    handle_path /wordcraft/* {
        encode zstd gzip
        reverse_proxy wordcraft-web:80
    }
    handle_path /gridcraft/* {
        encode zstd gzip
        reverse_proxy gridcraft-web:80
    }
    handle_path /pdfcraft/* {
        encode zstd gzip
        reverse_proxy pdfcraft-web:80
    }
    handle_path /deckcraft/* {
        encode zstd gzip
        reverse_proxy deckcraft-web:80
    }
    handle_path /ideacraft/* {
        encode zstd gzip
        reverse_proxy ideacraft-web:80
    }
    # MailCraft: web app + API (/mailcraft/api/...) del server multi-utente; il token utente viaggia nell'header Authorization
    handle_path /mailcraft/* {
        encode zstd gzip
        reverse_proxy mailcraft:7878 {
            header_up X-Forwarded-Prefix /mailcraft   # cosi' MailCraft costruisce bene l'URL di ritorno OAuth (/mailcraft/api/oauth/callback)
        }
    }

    # Webapp
    handle {
        encode zstd gzip
        reverse_proxy frontend:80
    }

    log {
        output file /data/access.log {
            roll_size 20mb
            roll_keep 5
        }
    }
}
