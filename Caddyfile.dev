# Profilo sviluppo/anteprima locale: http://localhost:8080, nessun certificato. Risponde su qualsiasi nome host (:8080),
# cosi' si raggiunge anche dagli altri PC della rete con http://<ip-del-mac>:8080.
# http://localhost e' un "secure context" per il browser: le passkey funzionano lo stesso (da altri PC in http no: usare l'app authenticator).
{
    auto_https off
}

http://:8080 {
    # Niente compressione su /api: con lo streaming SSE la compressione fa arrivare la risposta a blocchi.
    handle /api/* {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle /files/* {
        encode zstd gzip
        reverse_proxy backend:8000
    }

    # Editor nel browser (se i profili wordcraft / gridcraft sono attivi)
    handle_path /wordcraft/* {
        encode zstd gzip
        reverse_proxy wordcraft-web:80
    }
    handle_path /gridcraft/* {
        encode zstd gzip
        reverse_proxy gridcraft-web:80
    }
    handle_path /pdfcraft/* {
        encode zstd gzip
        reverse_proxy pdfcraft-web:80
    }
    handle_path /deckcraft/* {
        encode zstd gzip
        reverse_proxy deckcraft-web:80
    }
    handle_path /ideacraft/* {
        encode zstd gzip
        reverse_proxy ideacraft-web:80
    }
    # MailCraft: web app + API (/mailcraft/api/...) del server multi-utente; il token utente viaggia nell'header Authorization
    # RemoteCraft: web app + API del gestionale assistenza (il token del tecnico viaggia dopo #, non arriva qui)
    handle_path /remotecraft/* {
        encode zstd gzip
        reverse_proxy remotecraft:7979
    }
    handle_path /mailcraft/* {
        encode zstd gzip
        reverse_proxy mailcraft:7878 {
            header_up X-Forwarded-Prefix /mailcraft   # cosi' MailCraft costruisce bene l'URL di ritorno OAuth (/mailcraft/api/oauth/callback)
        }
    }
    handle {
        encode zstd gzip
        reverse_proxy frontend:80
    }
}
