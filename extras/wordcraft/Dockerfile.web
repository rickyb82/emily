# WordCraft nel browser (WebAssembly): l'editor completo servito da FamilAI su /wordcraft/.
# Build: trunk compila apps/wordcraft-web per wasm32 (lunga come quella della CLI, 15-40 minuti la prima volta).
# Prima della build viene applicata familai-web-patch.py: ?open=<url> apre un documento del server, ?save=<url>
# fa salvare sul server invece di scaricare. Il risultato e' un sito statico servito da nginx.
ARG WORDCRAFT_REPO=https://github.com/rickyb82/wordcraft
ARG WORDCRAFT_REF=main

FROM rust:1-bookworm AS build
ARG WORDCRAFT_REPO
ARG WORDCRAFT_REF
RUN apt-get update && apt-get install -y --no-install-recommends git python3 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
# trunk: binario precompilato (x86_64 o arm64)
RUN set -eux; arch="$(uname -m)"; case "$arch" in x86_64) t=x86_64-unknown-linux-gnu;; aarch64|arm64) t=aarch64-unknown-linux-gnu;; *) echo "arch $arch non supportata"; exit 1;; esac; \
    curl -fsSL "https://github.com/trunk-rs/trunk/releases/latest/download/trunk-${t}.tar.gz" | tar xz -C /usr/local/bin trunk; trunk --version
WORKDIR /src
RUN git clone --depth 1 --branch "$WORDCRAFT_REF" "$WORDCRAFT_REPO" .
COPY familai-web-patch.py /familai-web-patch.py
RUN python3 /familai-web-patch.py /src
WORKDIR /src/apps/wordcraft-web
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    trunk build --release && ls -la /src/dist/web

FROM nginx:alpine
COPY --from=build /src/dist/web /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  include /etc/nginx/mime.types;\n  gzip on; gzip_types application/wasm application/javascript text/css;\n  location / { try_files $uri $uri/ /index.html; add_header Cache-Control "public, max-age=86400"; }\n  location = /index.html { add_header Cache-Control "no-cache"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
