# ---- Esposizione pubblica (Caddy) ----
# Dominio che punta all'IP pubblico di casa (porte 80/443 inoltrate alla macchina Ubuntu)
PUBLIC_HOST=familai.example.com
ACME_EMAIL=tu@example.com
# HTTPS: acme = certificato pubblico automatico (serve un nome DNS pubblico e le porte 80/443 aperte verso il server);
# internal = certificato della CA interna di Caddy, per la rete locale (PUBLIC_HOST puo' essere anche un IP, es. 192.168.1.20):
# i PC devono fidarsi della CA una volta (./familai.sh ca-cert).
TLS_MODE=acme
# Porte esterne del server HTTPS (default 80 e 443). Con porte diverse l'indirizzo diventa https://<PUBLIC_HOST>:<HTTPS_PORT>
# e, in modalita' acme, il router deve inoltrare 80->HTTP_PORT e 443->HTTPS_PORT (o usa TLS_MODE=internal in rete locale).
#HTTP_PORT=8080
#HTTPS_PORT=8443

# ---- Sicurezza ----
# Genera con: openssl rand -hex 32
SECRET_KEY=cambiami
# WebAuthn: RP ID = dominio (senza porta), origin = URL completo
WEBAUTHN_RP_ID=familai.example.com
WEBAUTHN_RP_NAME=FamilAI
WEBAUTHN_ORIGIN=https://familai.example.com
# Obbliga gli adulti ad avere una passkey registrata prima di poter chattare
REQUIRE_MFA_FOR_ADULTS=true
# Durata sessione (ore): adulti / bambini
SESSION_HOURS_ADULT=168
SESSION_HOURS_CHILD=12

# ---- Primo amministratore (creato al primo avvio se il DB e' vuoto) ----
ADMIN_EMAIL=riccardo@example.com
ADMIN_PASSWORD=cambiami-subito
ADMIN_NAME=Riccardo
FAMILY_NAME=Famiglia

# ---- Provider LLM (lascia vuoto quello che non usi) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modello di default per ogni provider
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
OPENAI_DEFAULT_MODEL=gpt-4.1
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ---- Tool ----
# Ricerca web: auto = nativa di Claude quando il modello e' Claude, altrimenti OpenAI/Gemini con le loro chiavi;
# Tavily/Brave sono opzionali. Valori: auto | openai | gemini | tavily | brave
# Ricerca web in casa con SearXNG (servizio incluso nel compose, nessuna chiave). Vuoto = disattivato.
SEARXNG_URL=http://searxng:8080
WEB_SEARCH_PROVIDER=auto
ANTHROPIC_NATIVE_SEARCH=true
TAVILY_API_KEY=
BRAVE_API_KEY=
# Generazione immagini: auto = OpenAI se c'e' la chiave, altrimenti Gemini (Imagen)
IMAGE_PROVIDER=auto
IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# Generazione video (Gemini / Veo)
VIDEO_MODEL=veo-3.0-generate-001
# Moderazione contenuti per i bambini (usa OpenAI moderation se OPENAI_API_KEY presente)
CHILD_MODERATION=true

# ---- Email (SMTP) — impostabile anche da Famiglia -> Provider AI -> Email ----
# Gmail: smtp.gmail.com, porta 587, STARTTLS, utente = indirizzo Gmail, password = "password per le app"
# (Account Google -> Sicurezza -> Verifica in due passaggi -> Password per le app). NON la password normale.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FamilAI
# Consente di completare il login con un codice via email al posto della passkey (true/false)
EMAIL_MFA_FALLBACK=true

# ---- Accesso con Google (client OAuth 'Applicazione web'; impostabile anche dal pannello) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Coding: sandbox di esecuzione (servizio 'sandbox' nel compose; gia' impostato da docker-compose.yml) ----
# SANDBOX_URL=http://sandbox:8080
SANDBOX_TIMEOUT=60

# ---- RAG (ricerca nei documenti di progetto) ----
# auto = usa OpenAI se c'e' OPENAI_API_KEY, altrimenti Gemini; none = solo ricerca per parole chiave (nessuna chiave necessaria)
EMBEDDING_PROVIDER=auto
# vuoto = text-embedding-3-small (OpenAI) / gemini-embedding-001 (Gemini)
EMBEDDING_MODEL=
RAG_CHUNK_CHARS=2500
RAG_TOP_K=6

# ---- Sviluppo ----
# In dev (senza HTTPS) imposta a false per permettere i cookie su http://localhost
COOKIE_SECURE=true
LOG_LEVEL=info

# Compattazione chat lunghe: oltre il budget i messaggi vecchi vengono riassunti e archiviati (cercabili)
COMPACTION_ENABLED=true
CONTEXT_BUDGET_TOKENS=24000
CONTEXT_KEEP_TOKENS=8000

# Risposte lunghe: continuazione automatica fino a questo totale di token generati
AUTO_CONTINUE=true
MAX_TOTAL_OUTPUT_TOKENS=256000

# Immagini in casa (ComfyUI): attesa massima per immagine in secondi
COMFYUI_TIMEOUT=1800

# App ArtCraft (opzionali): WordCraft (Word), GridCraft (Excel), PdfCraft (PDF), DeckCraft (PowerPoint), open source in Rust, con server MCP
# per il modello ed editor completo nel browser (menu 📝 Documenti). Avvio: ./familai.sh wordcraft|gridcraft|pdfcraft|deckcraft up
# (compila Rust: la prima volta e' lunga). Equivale a COMPOSE_PROFILES=wordcraft,gridcraft + le righe sotto.
#WORDCRAFT_HOST=wordcraft:7982
#WORDCRAFT_WEB=1
#GRIDCRAFT_HOST=gridcraft:7983
#GRIDCRAFT_WEB=1
#PDFCRAFT_HOST=pdfcraft:7984
#PDFCRAFT_WEB=1
#DECKCRAFT_HOST=deckcraft:7985
#DECKCRAFT_WEB=1
#IDEACRAFT_HOST=ideacraft:7986
#IDEACRAFT_WEB=1
# MailCraft (./familai.sh mailcraft up): posta elettronica IMAP/SMTP per utente, web app su /mailcraft/ e tool in chat.
# MAILCRAFT_TOKEN e' il token di servizio backend<->server (generato da familai.sh, non darlo a nessuno); i dati stanno in private/mailcraft.
#MAILCRAFT_URL=http://mailcraft:7878
#MAILCRAFT_MCP_HOST=mailcraft:7889
#MAILCRAFT_TOKEN=
# Accesso Gmail / Microsoft 365 con OAuth (XOAUTH2) invece della password per le app: client "Applicazione web" creato nella
# console del provider con URI di reindirizzamento https://<PUBLIC_HOST>/mailcraft/api/oauth/callback (in sviluppo
# http://localhost:8080/mailcraft/api/oauth/callback). MAILCRAFT_PUBLIC_URL serve solo se il proxy non manda gli X-Forwarded-*.
#MAILCRAFT_GOOGLE_CLIENT_ID=1234-abcd.apps.googleusercontent.com
#MAILCRAFT_GOOGLE_CLIENT_SECRET=GOCSPX-...
#MAILCRAFT_MICROSOFT_CLIENT_ID=
#MAILCRAFT_MICROSOFT_CLIENT_SECRET=
#MAILCRAFT_PUBLIC_URL=

# Marchio: l'interfaccia e l'assistente si chiamano Emily (logo Sirius); i nomi tecnici restano FamilAI.
#APP_NAME=Emily
# Modalita' azienda (anche dal pannello Organizzazione > Membri): nessun bambino, condivisione cercando i colleghi per nome o email.
#ORG_MODE=1
# Passkey: PASSKEYS=0 le disattiva (secondo fattore solo con l'app authenticator), es. server locale senza dominio fisso.
#PASSKEYS=0
# Secondo fattore a scelta dell'utente al primo accesso (1, default) oppure obbligatorio per gli adulti (0).
#MFA_OPTIONAL=1
